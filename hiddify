#!/bin/bash

APPIMAGE="/home/elo/AppImages/hiddify.appimage"
ENV_VARS="__NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia"

# Function to validate sudo password
prompt_sudo() {
  while true; do
    echo -n "Please enter your sudo password: "
    read -s SUDO_PASS
    echo

    # Validate sudo password without running the main command yet
    echo "$SUDO_PASS" | sudo -S -v > /dev/null 2>&1
    if [ $? -eq 0 ]; then
      break
    else
      echo "Incorrect password, please try again."
    fi
  done
}

# Prompt and validate
prompt_sudo

# Run the AppImage using the verified password
echo "$SUDO_PASS" | sudo -S env $ENV_VARS "$APPIMAGE" > /dev/null 2>&1 &

# Notify the user
echo "The application is starting in the background."

